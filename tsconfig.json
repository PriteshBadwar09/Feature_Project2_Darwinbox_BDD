
{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"],
        "outDir": "dist"
    },
    "include": [
        "features/**/*.ts",
        "step-definitions/**/*.ts",
        "pages/**/*.ts",
        "support/**/*.ts"
    ]
}
